digraph G {
  graph [rankdir=TB, fontname="Microsoft YaHei", fontsize=11, nodesep=0.55, ranksep=0.32, pad=0.15];
  node [fontname="Microsoft YaHei", fontsize=10, penwidth=1.0, shape=box, style="rounded,filled", fillcolor="#EAF1FB"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#555555", arrowsize=0.7];
  start [shape=ellipse, style=filled, fillcolor="#E8F5E9", label="开始"];
  end [shape=ellipse, style=filled, fillcolor="#FDE7E7", label="结束"];

  start -> input;
  input [label="输入用户名与密码"];
  input -> empty [label=" "]; empty [label="用户名或密码为空?", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  empty -> tip1 [label=" 是"]; tip1 [label="提示请输入用户名和密码"]; tip1 -> input;
  empty -> auth [label=" 否"]; auth [label="校验账号密码"];
  auth -> ok [label=" "]; ok [label="认证成功?", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  ok -> tip2 [label=" 否"]; tip2 [label="提示用户名或密码错误"]; tip2 -> input;
  ok -> logged [label=" 是"]; logged [label="已登录访问登录页?", shape=diamond, style="filled", fillcolor="#FFF4E0"];
  logged -> home [label=" 否"]; home [label="进入系统首页"];
  logged -> home2 [label=" 是"]; home2 [label="直接跳转首页"]; home2 -> home;
  home -> end;
}
