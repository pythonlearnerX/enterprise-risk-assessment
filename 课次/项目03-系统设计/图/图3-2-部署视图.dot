digraph DEP {
  graph [rankdir=LR, fontname="Microsoft YaHei", fontsize=11, nodesep=0.45, ranksep=0.8, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=10,
        fillcolor="#EAF1FB", color="#3B6EA5", penwidth=1.0, margin="0.2,0.1"];
  edge [color="#6B7280", arrowsize=0.7, fontname="Microsoft YaHei", fontsize=9];

  browser [label="浏览器\nChrome / Edge", fillcolor="#F3F4F6", color="#6B7280"];
